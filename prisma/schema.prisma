  goal                 String?
  projectType          String?
  summary              String?
  targetUsers          String?
  platforms            String?
  deploymentTarget     String?
  mvpIncludedScope     String?
  mvpExcludedScope     String?
  futureScope          String?
  technicalConstraints String?
  businessConstraints  String?
  platformConstraints  String?
  legalConstraints     String?
  otherConstraints     String?
  budget               String?
  timeline             String?
  assumptions          String?
  risks                String?
