datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model Conversation {
  id                  String                 @id @default(uuid())
  title               String
  status              String                 // "Active", "Completed", "Paused"
  currentStage        String                 // "Queen", "Planner", etc.
  originalPrompt      String?
  qualityGateOverride Boolean                @default(false)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  outputs             AgentOutput[]
  history             ExecutionHistory[]
  executiveMemory     ExecutiveMemory[]

  // NEW Graph & Ledger Relations
  nodes               GraphNode[]
  edges               GraphEdge[]
  stageLogs           StageExecutionLog[]
  correlations        Correlation[]

  // Dedicated Stage Output Relations
  queenOutput         QueenStageOutput?
  plannerOutput       PlannerStageOutput?
  architectOutput     ArchitectStageOutput?
  systemOutput        SystemStageOutput?
  designerOutput      DesignerStageOutput?
  blueprinterOutput   BlueprinterStageOutput?
  testerOutput        TesterStageOutput?
  debuggerOutput      DebuggerStageOutput?
  reviewerOutput      ReviewerStageOutput?
  securityOutput      SecurityStageOutput?
}

model AgentOutput {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentName      String
  stage          String
  schemaVersion  String
  model          String
  validatedJson  String       // Store stringified JSON
  executionTime  Int          // in ms
  tokenUsage     Int
  attempt        Int
  createdAt      DateTime     @default(now())
  indexes        AgentIndex[]
}

model AgentIndex {
  id             String      @id @default(uuid())
  conversationId String
  outputId       String
  output         AgentOutput @relation(fields: [outputId], references: [id], onDelete: Cascade)
  path           String      // e.g. "Planner.features"
  value          String      // Stringified JSON value
  createdAt      DateTime    @default(now())
}

model ExecutionHistory {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  stage          String
  status         String       // "Success", "Failed", "Retrying"
  logs           String       // Stringified array of logs or raw text logs
  createdAt      DateTime     @default(now())
}

model ExecutiveMemory {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Readable unique inference identity per agent call
  inferenceId    String       // e.g. "Queen-1-a3f8c2", "Coder-3-f70d9e"

  // Per-agent write identity
  agentName      String       // "Queen" | "Planner" | "Architect" | "System" | "Designer"
                              // "Blueprinter" | "Coder" | "Debugger" | "Security" | "Reviewer" | "Tester"
  sequence       Int          @default(1) // monotonically increasing per (conversation, agentName)

  // Content & Provenance
  contentMd      String       // raw sanitized markdown output
  consumedIds    String       @default("[]") // JSON array of upstream inferenceId strings consumed

  // File-level tracking (Coder & Debugger file writes)
  filePath       String?      // e.g. "src/index.ts" (null for spec agents)

  // Telemetry
  tokenCount     Int          @default(0)
  durationMs     Int          @default(0)

  // Lifecycle & Oscillation Detection
  status         String       @default("ACTIVE")  // "ACTIVE" | "SUPERSEDED" | "INVALIDATED"
  contentHash    String?      // MD5 of contentMd — used for oscillation detection across runs

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([conversationId, inferenceId])
  @@unique([conversationId, agentName, sequence])
  @@index([conversationId, agentName, status])
  @@index([conversationId, filePath])
  @@index([conversationId, status])
}

// ====================================================
// NEW HYBRID GRAPH-DOCUMENT LEDGER TABLES
// ====================================================

model GraphNode {
  id             String       @id // Format: "${conversationId}:${rawNodeId}"
  conversationId String
  type           String       // TASK_SPEC, FEATURE, MODULE, API_ENDPOINT, UI_COMPONENT, TEST_SPEC, UNSTRUCTURED_BLOB
  title          String
  summary        String?
  payload        String       // Stringified JSON Document
  version        Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  outgoingEdges  GraphEdge[]  @relation("SourceEdges")
  incomingEdges  GraphEdge[]  @relation("TargetEdges")

  @@index([conversationId, type])
}

model GraphEdge {
  id             String       @id @default(uuid())
  conversationId String
  sourceNodeId   String
  targetNodeId   String
  type           String       // IMPLEMENTS, DEPENDS_ON, EXPOSES, CALLS, TESTS, BELONGS_TO
  metadata       String?      // Optional edge properties JSON

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sourceNode     GraphNode    @relation("SourceEdges", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode     GraphNode    @relation("TargetEdges", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sourceNodeId, targetNodeId, type])
  @@index([conversationId, sourceNodeId])
  @@index([conversationId, targetNodeId])
}

model StageExecutionLog {
  id             String       @id @default(uuid())
  conversationId String
  stageName      String       // Queen, Planner, Architect, System, Designer, Tester, Coder, etc.
  repairLoops    Int          @default(0)
  rawOutput      String
  status         String       // SUCCESS, FUZZY_REPAIRED, FAILED
  errorMessage   String?
  sequence       Int          @default(0)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ====================================================
// NEW DEDICATED PER-STAGE OUTFLOW TABLES
// ====================================================

model QueenStageOutput {
  id                   String       @id @default(uuid())
  conversationId       String       @unique
