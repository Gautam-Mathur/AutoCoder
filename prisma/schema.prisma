// ====================================================
// CANONICAL CORRELATION INDEX TABLE
// ====================================================

model Correlation {
  id              String       @id @default(uuid())
  correlationCode String       @unique // e.g. Q-822ca-i0001
  conversationId  String
  agentCode       String       // Q, P, A, BA, UI, B, T, D, R, S
  sequence        Int          @default(1)
  stage           String       // Queen, Planner, Architect, System, Designer, Blueprinter, Tester, Debugger, Reviewer, Security
  stageOutputId   String
  schemaVersion   String       @default("1.0")
  status          String       @default("ACTIVE") // ACTIVE, SUPERSEDED, INVALIDATED, FAILED
  createdAt       DateTime     @default(now())

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, agentCode, sequence])
  @@index([conversationId, status])
}

// ====================================================
// VIRTUAL FILE SYSTEM (VFS) TABLE
// ====================================================

model VirtualFile {
  id             String   @id @default(cuid())
  conversationId String
  filePath       String
  content        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([conversationId, filePath])
  @@index([conversationId])
}

