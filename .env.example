# Local SQLite Database used by Prisma
DATABASE_URL="file:./dev.db"

# Default LLM Provider Routing ('ollama' | 'openai' | 'anthropic')
LLM_PROVIDER="ollama"

# Local Ollama Configuration
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3-coder:30b"

# Cloud Provider Credentials (populate locally in .env or .env.local; never commit)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"
